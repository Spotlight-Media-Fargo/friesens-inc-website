{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/contact-friesens",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/contact-friesens/",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/our-company",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/our-company/",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/solutions/solutions",
      "destination": "/solutions/",
      "permanent": true
    },
    {
      "source": "/solutions/solutions/",
      "destination": "/solutions/",
      "permanent": true
    },
    {
      "source": "/solutions/plastic-modular-conveyors",
      "destination": "/solutions/",
      "permanent": true
    },
    {
      "source": "/solutions/plastic-modular-conveyors/",
      "destination": "/solutions/",
      "permanent": true
    },
    {
      "source": "/solutions/bacon-systems",
      "destination": "/solutions/",
      "permanent": true
    },
    {
      "source": "/solutions/bacon-systems/",
      "destination": "/solutions/",
      "permanent": true
    },
    {
      "source": "/industries/confectionary",
      "destination": "/industries/",
      "permanent": true
    },
    {
      "source": "/industries/confectionary/",
      "destination": "/industries/",
      "permanent": true
    },
    {
      "source": "/support",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/support/",
      "destination": "/contact/",
      "permanent": true
    }
  ]
}
